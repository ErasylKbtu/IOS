                                            <constraint firstItem="message-button" firstAttribute="width" id="c-0076" secondItem="follow-button" secondAttribute="width" userLabel="Equal button widths" />
                                            <constraint firstItem="about-card" firstAttribute="top" id="c-0077" secondItem="follow-button" secondAttribute="bottom" constant="24" />
                                            <constraint firstItem="profile-content" firstAttribute="bottom" id="c-0078" secondItem="about-card" secondAttribute="bottom" constant="24" />
                                        </constraints>
                                    </view>
                                </subviews>
                                <viewLayoutGuide key="contentLayoutGuide" id="scroll-content-guide" />
                                <viewLayoutGuide key="frameLayoutGuide" id="scroll-frame-guide" />
                                <constraints>
                                    <constraint firstItem="profile-content" firstAttribute="leading" id="c-0079" secondItem="scroll-content-guide" secondAttribute="leading" constant="16" />
                                    <constraint firstItem="scroll-content-guide" firstAttribute="trailing" id="c-0080" secondItem="profile-content" secondAttribute="trailing" constant="16" />
                                    <constraint firstItem="profile-content" firstAttribute="top" id="c-0081" secondItem="scroll-content-guide" secondAttribute="top" />
                                    <constraint firstItem="scroll-content-guide" firstAttribute="bottom" id="c-0082" secondItem="profile-content" secondAttribute="bottom" />
                                    <constraint firstItem="profile-content" firstAttribute="width" id="c-0083" secondItem="scroll-frame-guide" secondAttribute="width" constant="-32" userLabel="Viewport width minus side margins" />
                                </constraints>
                            </scrollView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-area" />
                        <constraints>
                            <constraint firstItem="profile-scroll" firstAttribute="leading" id="c-0084" secondItem="safe-area" secondAttribute="leading" />
                            <constraint firstItem="profile-scroll" firstAttribute="trailing" id="c-0085" secondItem="safe-area" secondAttribute="trailing" />
                            <constraint firstItem="profile-scroll" firstAttribute="top" id="c-0086" secondItem="safe-area" secondAttribute="top" />
                            <constraint firstItem="profile-scroll" firstAttribute="bottom" id="c-0087" secondItem="safe-area" secondAttribute="bottom" />
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="initialsLabel" destination="initials-label" id="initialsLabel-outlet" />
                        <outlet property="nameLabel" destination="name-label" id="nameLabel-outlet" />
                        <outlet property="subtitleLabel" destination="subtitle-label" id="subtitleLabel-outlet" />
                        <outlet property="postsLabel" destination="stat-0" id="postsLabel-outlet" />
                        <outlet property="followersLabel" destination="stat-1" id="followersLabel-outlet" />
                        <outlet property="followingLabel" destination="stat-2" id="followingLabel-outlet" />
                        <outlet property="aboutLabel" destination="about-label" id="aboutLabel-outlet" />
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" userLabel="First Responder" sceneMemberID="firstResponder" />
            </objects>
        </scene>
    </scenes>
</document>